      "packagedWorkingDirectoryRelativePath": "core"
    },
    {
      "target": "linux-x64",
      "architecture": "x64",
      "packagedPythonRelativePath": "python/bin/python3",
      "packagedResourceRootRelativePath": "core",
      "packagedCoreEntryRelativePath": "core/app/core_host/__main__.py",
