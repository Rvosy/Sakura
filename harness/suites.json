{
  "schema_version": 1,
  "profiles": {
    "smoke": {
      "description": "快速验证 Harness 自身与 Runtime v2 核心协议边界",
      "cases": [
        "harness-self-test",
        "harness-agent-development-tests",
        "core-host-protocol"
      ]
    },
    "harness-v1": {
      "description": "验证任务契约、Work Package、Git 范围和任务报告",
      "cases": [
        "harness-self-test",
        "harness-agent-development-tests"
      ]
    },
    "docs": {
      "description": "验证文档目录、元数据、链接和真相源约束",
      "cases": [
        "docs-check",
        "docs-structure-tests"
      ]
    },
    "unit": {
      "description": "运行完整 Python 单元测试集",
      "cases": [
        "python-unit-tests"
      ]
    },
    "core-host": {
      "description": "验证 Runtime v2 Python Core Host 的协议、适配器与真实本地生命周期",
      "cases": [
        "core-host-unit-tests",
        "core-host-integration-tests",
        "runtime-v2-memory-tests"
      ]
    },
    "legacy-qt-ui": {
      "description": "冻结迁移期 Legacy Qt 桌宠 UI 参考行为",
      "cases": [
        "legacy-qt-ui-tests"
      ]
    },
    "python-full": {
      "description": "运行完整 Python 单元、集成与迁移参考 Qt UI 回归",
      "cases": [
        "python-unit-tests",
        "python-integration-tests",
        "legacy-qt-ui-tests"
      ]
    },
    "runtime-v2-shell": {
      "description": "验证 Runtime v2 桌面壳前端与原生窗口交互边界",
      "cases": [
        "runtime-v2-frontend-tests",
        "runtime-v2-provider-model-tests",
        "runtime-v2-memory-tests",
        "runtime-v2-character-appearance-tests",
        "runtime-v2-character-presentation-tests",
        "runtime-v2-product-shell-tests",
        "runtime-v2-window-geometry-tests",
        "runtime-v2-window-interaction-tests"
      ]
    },
    "runtime-v2-windows-interaction": {
      "description": "在真实 Windows 桌面验证 Runtime v2 原生透明穿透",
      "cases": [
        "runtime-v2-windows-transparent-clickthrough"
      ]
    }
  },
  "cases": [
    {
      "id": "docs-check",
      "description": "运行文档结构、元数据、链接和真相源检查",
      "argv": [
        "{python}",
        "tools/check_docs.py"
      ],
      "timeout_seconds": 60,
      "env": {
        "PYTHONDONTWRITEBYTECODE": "1",
        "PYTHONIOENCODING": "utf-8"
      }
    },
    {
      "id": "docs-structure-tests",
      "description": "运行文档规范检查的单元测试",
      "argv": [
        "{python}",
        "-m",
        "pytest",
        "tests/unit/test_docs_structure.py",
        "-q"
      ],
      "timeout_seconds": 60,
      "env": {
        "PYTHONDONTWRITEBYTECODE": "1",
        "PYTHONIOENCODING": "utf-8"
      }
    },
    {
      "id": "harness-self-test",
      "description": "验证 Harness 清单、执行器和报告契约",
      "argv": [
        "{python}",
        "-m",
        "pytest",
        "tests/unit/test_harness_runner.py",
        "-q"
      ],
      "timeout_seconds": 60,
      "env": {
        "PYTHONDONTWRITEBYTECODE": "1",
        "PYTHONIOENCODING": "utf-8"
      }
    },
    {
      "id": "harness-agent-development-tests",
      "description": "验证任务契约、Work Package、Git 范围和任务报告",
      "argv": [
        "{python}",
        "-m",
        "pytest",
        "tests/unit/test_harness_agent_development.py",
        "-q"
      ],
      "timeout_seconds": 120,
      "env": {
        "PYTHONDONTWRITEBYTECODE": "1",
        "PYTHONIOENCODING": "utf-8"
      }
    },
    {
      "id": "core-host-protocol",
      "description": "验证 Runtime v2 Core Host 帧协议与控制边界",
      "argv": [
        "{python}",
        "-m",
        "pytest",
        "tests/unit/test_core_host_protocol.py",
        "-q"
      ],
      "timeout_seconds": 120,
      "env": {
        "PYTHONDONTWRITEBYTECODE": "1",
        "PYTHONIOENCODING": "utf-8"
      }
    },
    {
      "id": "python-unit-tests",
      "description": "运行 tests/unit 下的完整 Python 单元测试",
      "argv": [
        "{python}",
        "-m",
        "pytest",
        "tests/unit",
        "-q"
      ],
      "timeout_seconds": 600,
      "env": {
        "PYTHONDONTWRITEBYTECODE": "1",
        "PYTHONIOENCODING": "utf-8"
      }
    },
    {
      "id": "core-host-unit-tests",
      "description": "验证 Core Host 协议、配置、Adapter、readiness 与聊天边界",
      "argv": [
        "{python}",
        "-m",
        "pytest",
        "tests/unit",
        "-k",
        "core_host or wp_2_02_chat_boundary",
        "-q"
      ],
      "timeout_seconds": 180,
      "env": {
        "PYTHONDONTWRITEBYTECODE": "1",
        "PYTHONIOENCODING": "utf-8"
      }
    },
    {
      "id": "core-host-integration-tests",
      "description": "以本地确定性 Provider 验证真实 Core Host 进程与生命周期",
      "argv": [
        "{python}",
        "-m",
        "pytest",
        "tests/integration",
        "-k",
        "core_host or wp_3v_01_assistant_architecture or wp_4_01_memory_capability",
        "-q"
      ],
      "timeout_seconds": 180,
      "env": {
        "PYTHONDONTWRITEBYTECODE": "1",
        "PYTHONIOENCODING": "utf-8"
      }
    },
    {
      "id": "python-integration-tests",
      "description": "运行离线 Python 集成测试",
      "argv": [
        "{python}",
        "-m",
        "pytest",
        "tests/integration",
        "-q"
      ],
      "timeout_seconds": 300,
      "env": {
        "PYTHONDONTWRITEBYTECODE": "1",
        "PYTHONIOENCODING": "utf-8"
      }
    },
    {
      "id": "legacy-qt-ui-tests",
      "description": "在 offscreen Qt 平台运行迁移参考 Qt UI 测试",
      "argv": [
        "{python}",
        "-m",
        "pytest",
        "tests/ui",
        "-q"
      ],
      "timeout_seconds": 300,
      "env": {
        "PYTHONDONTWRITEBYTECODE": "1",
        "PYTHONIOENCODING": "utf-8",
        "QT_QPA_PLATFORM": "offscreen"
      }
    },
    {
      "id": "runtime-v2-frontend-tests",
      "description": "验证 Runtime v2 桌宠、设置页与自绘菜单前端契约",
      "argv": [
        "node",
        "--test",
        "desktop/frontend/tests/*.test.js"
      ],
      "timeout_seconds": 120,
      "env": {
        "NO_COLOR": "1"
      }
    },
    {
      "id": "runtime-v2-provider-model-tests",
      "description": "验证 Provider/模型公开 DTO、密钥语义、原子保存与有界探测",
      "argv": [
        "{python}",
        "-m",
        "pytest",
        "tests/unit/test_provider_model_settings.py",
        "tests/unit/test_core_host_provider_settings.py",
        "-q"
      ],
      "timeout_seconds": 120,
      "env": {
        "PYTHONDONTWRITEBYTECODE": "1",
        "PYTHONIOENCODING": "utf-8"
      }
    },
    {
      "id": "runtime-v2-memory-tests",
      "description": "验证 Memory owner、降级召回、整理游标、设置 DTO、窗口授权与代际边界",
      "argv": [
        "{python}",
        "-m",
        "pytest",
        "tests/unit/test_core_host_memory.py",
        "tests/integration/test_wp_4_01_memory_capability.py",
        "-q"
      ],
      "timeout_seconds": 180,
      "env": {
        "PYTHONDONTWRITEBYTECODE": "1",
        "PYTHONIOENCODING": "utf-8"
      }
    },
    {
      "id": "runtime-v2-character-appearance-tests",
      "description": "验证角色外观预览、保存、回滚与代际绑定",
      "argv": [
        "cargo",
        "test",
        "--manifest-path",
        "desktop/src-tauri/Cargo.toml",
        "--locked",
        "character_appearance",
        "--",
        "--test-threads=1"
      ],
      "timeout_seconds": 180,
      "env": {
        "NO_COLOR": "1",
        "CARGO_TERM_COLOR": "never"
      }
    },
    {
      "id": "runtime-v2-character-presentation-tests",
      "description": "验证干净检出与角色表现资源的安全加载边界",
      "argv": [
        "cargo",
        "test",
        "--manifest-path",
        "desktop/src-tauri/Cargo.toml",
        "--locked",
        "character_presentation",
        "--",
        "--test-threads=1"
      ],
      "timeout_seconds": 180,
      "env": {
        "NO_COLOR": "1",
        "CARGO_TERM_COLOR": "never"
      }
    },
    {
      "id": "runtime-v2-product-shell-tests",
      "description": "验证设置窗口、托盘、退出协调与菜单能力清单",
      "argv": [
        "cargo",
        "test",
        "--manifest-path",
        "desktop/src-tauri/Cargo.toml",
        "--locked",
        "product_shell",
        "--",
        "--test-threads=1"
      ],
      "timeout_seconds": 180,
      "env": {
        "NO_COLOR": "1",
        "CARGO_TERM_COLOR": "never"
      }
    },
    {
      "id": "runtime-v2-window-geometry-tests",
      "description": "验证固定桌宠窗口布局、DPI 与多显示器几何约束",
      "argv": [
        "cargo",
        "test",
        "--manifest-path",
        "desktop/src-tauri/Cargo.toml",
        "--locked",
        "window_geometry",
        "--",
        "--test-threads=1"
      ],
      "timeout_seconds": 180,
      "env": {
        "NO_COLOR": "1",
        "CARGO_TERM_COLOR": "never"
      }
    },
    {
      "id": "runtime-v2-window-interaction-tests",
      "description": "验证命中区域、透明穿透、拖拽与菜单交互边界",
      "argv": [
        "cargo",
        "test",
        "--manifest-path",
        "desktop/src-tauri/Cargo.toml",
        "--locked",
        "window_interaction",
        "--",
        "--test-threads=1"
      ],
      "timeout_seconds": 180,
      "env": {
        "NO_COLOR": "1",
        "CARGO_TERM_COLOR": "never"
      }
    },
    {
      "id": "runtime-v2-windows-transparent-clickthrough",
      "description": "构建桌面壳并验证透明像素点击跨进程到达背景窗口",
      "argv": [
        "pwsh",
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "desktop/tests/windows_transparent_clickthrough_acceptance.ps1",
        "-Build",
        "-EvidenceDirectory",
        "temp/harness/windows-transparent-clickthrough"
      ],
      "timeout_seconds": 300,
      "env": {
        "NO_COLOR": "1",
        "CARGO_TERM_COLOR": "never"
      }
    }
  ]
}
