{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sakura.local/harness/activations/schema-v1.json",
  "title": "Sakura Agent Development Harness activation anchor v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "sequence",
    "task_id",
    "kind",
    "base_ref",
    "supersedes"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "sequence": {"type": "integer", "minimum": 1},
    "task_id": {"type": "string", "pattern": "^WP-[A-Z0-9]+(?:-[A-Z0-9]+)+$"},
    "kind": {"enum": ["activation", "contract_revision"]},
    "base_ref": {"type": "string", "pattern": "^[0-9a-fA-F]{40}$"},
    "supersedes": {
      "oneOf": [
        {"type": "null"},
        {"type": "string", "pattern": "^[0-9]{4}$"}
      ]
    }
  }
}
