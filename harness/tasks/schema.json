{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sakura.local/harness/tasks/schema-v2.json",
  "title": "Sakura Agent Development Harness task contract v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "base_ref",
    "allowed_paths",
    "required_profiles"
  ],
  "properties": {
    "schema_version": {"const": 2},
    "id": {"type": "string", "pattern": "^WP-[A-Z0-9]+(?:-[A-Z0-9]+)+$"},
    "base_ref": {"type": "string", "pattern": "^[0-9a-fA-F]{40}$"},
    "allowed_paths": {"$ref": "#/$defs/nonEmptyUniquePaths"},
    "required_profiles": {"$ref": "#/$defs/nonEmptyUniqueStrings"}
  },
  "$defs": {
    "nonEmptyUniqueStrings": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "nonEmptyUniquePaths": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^(?!/)(?!\\./)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\*?\\[]+(?:/\\*\\*)?$"
      },
      "uniqueItems": true
    }
  }
}
