{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sakura.local/harness/tasks/schema-v1.json",
  "title": "Sakura Agent Development Harness task contract v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "title",
    "status_source",
    "documents",
    "dependencies",
    "base_ref",
    "allowed_paths",
    "forbidden_paths",
    "protected_paths",
    "dependency_policy",
    "required_profiles",
    "acceptance",
    "rollback"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "id": {"type": "string", "pattern": "^WP-[A-Z0-9]+(?:-[A-Z0-9]+)+$"},
    "title": {"type": "string", "minLength": 1},
    "status_source": {"const": "docs/plans/runtime-v2/work-packages.md"},
    "documents": {
      "type": "object",
      "additionalProperties": false,
      "required": ["specs", "adrs", "plans"],
      "properties": {
        "specs": {"$ref": "#/$defs/uniqueStrings"},
        "adrs": {"$ref": "#/$defs/uniqueStrings"},
        "plans": {"$ref": "#/$defs/uniqueStrings"}
      },
      "anyOf": [
        {"properties": {"specs": {"minItems": 1}}},
        {"properties": {"adrs": {"minItems": 1}}},
        {"properties": {"plans": {"minItems": 1}}}
      ]
    },
    "dependencies": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "base_ref": {"type": "string", "pattern": "^[0-9a-fA-F]{40}$"},
    "allowed_paths": {"$ref": "#/$defs/nonEmptyUniquePaths"},
    "forbidden_paths": {"$ref": "#/$defs/nonEmptyUniquePaths"},
    "protected_paths": {"$ref": "#/$defs/nonEmptyUniquePaths"},
    "dependency_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "allowed_files"],
      "properties": {
        "mode": {"enum": ["forbidden", "allowlisted"]},
        "allowed_files": {"$ref": "#/$defs/uniquePaths"}
      },
      "allOf": [
        {
          "if": {"properties": {"mode": {"const": "forbidden"}}},
          "then": {"properties": {"allowed_files": {"maxItems": 0}}}
        }
      ]
    },
    "required_profiles": {"$ref": "#/$defs/nonEmptyUniqueStrings"},
    "acceptance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["automated", "manual"],
      "properties": {
        "automated": {"$ref": "#/$defs/nonEmptyUniqueStrings"},
        "manual": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
      }
    },
    "rollback": {"$ref": "#/$defs/nonEmptyUniqueStrings"}
  },
  "$defs": {
    "uniqueStrings": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "nonEmptyUniqueStrings": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "uniquePaths": {
      "type": "array",
      "items": {"$ref": "#/$defs/path"},
      "uniqueItems": true
    },
    "nonEmptyUniquePaths": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/path"},
      "uniqueItems": true
    },
    "path": {
      "type": "string",
      "pattern": "^(?!/)(?!\\./)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\*?\\[]+(?:/\\*\\*)?$"
    }
  }
}
