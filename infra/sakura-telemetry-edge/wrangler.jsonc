{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "sakura-telemetry-edge",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sakura-telemetry"
    }
  ]
}
